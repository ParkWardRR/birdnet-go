# Example rootless Podman Quadlet: ~/.config/containers/systemd/birdnet-go.container
# Needs: NVIDIA driver (580 branch is the last with Pascal support), NVIDIA Container
# Toolkit with a CDI spec (nvidia-cdi-refresh.service writes /var/run/cdi/nvidia.yaml at
# boot), and on SELinux hosts: setsebool -P container_use_devices on
[Unit]
Description=BirdNET-Go (CUDA)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/birdnet-go:p1000
ContainerName=birdnet-go
UserNS=keep-id
Environment=BIRDNET_UID=1000
Environment=BIRDNET_GID=1000
Environment=BIRDNET_ORT_EP=cuda
AddDevice=nvidia.com/gpu=all
Volume=%h/birdnet/config:/config:Z
Volume=%h/birdnet/data:/data:Z
PublishPort=8080:8080
HealthCmd=curl -fs --max-time 5 http://localhost:8080/health
HealthInterval=60s
HealthStartPeriod=180s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
TimeoutStartSec=900
# Wait for the boot-time CDI spec before Podman resolves nvidia.com/gpu.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -s /var/run/cdi/nvidia.yaml ] && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=default.target
